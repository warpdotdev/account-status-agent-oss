# Grainiac configuration.
#
# For local script testing: copy this file to `.env`, fill in the values, and
# export them before running (e.g. `set -a; source .env; set +a`).
#
# For Oz cloud runs: set each of these as a team secret instead, e.g.
# `oz secret create --team GRAINIAC_GRAIN_TOKEN`. Warp injects team secrets
# into cloud agent runs as environment variables.

# --- Required ---
# Grain personal access token
GRAINIAC_GRAIN_TOKEN=
# Notion integration token
GRAINIAC_NOTION_TOKEN=
# Notion Account Tracking database ID (from the database URL)
GRAINIAC_NOTION_DATABASE_ID=

# --- Recommended ---
# Your company email domain, used to separate internal vs. external
# participants (e.g. example.com). If unset, only participants Grain marks as
# internal are treated as internal.
GRAINIAC_INTERNAL_DOMAIN=

# --- Optional ---
# Name of the Notion database's title property (default: Company)
GRAINIAC_NOTION_TITLE_PROPERTY=Company
# Timezone used to resolve "today" (default: America/Los_Angeles)
GRAINIAC_TIMEZONE=America/Los_Angeles

# --- Slack summary skill only ---
# Slack Bot OAuth token (xoxb-...)
GRAINIAC_SLACK_TOKEN=
# Slack channel to post summaries to (e.g. #meeting-summaries)
GRAINIAC_SLACK_CHANNEL=
